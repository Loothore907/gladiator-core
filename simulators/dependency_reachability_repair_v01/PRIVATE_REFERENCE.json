{
  "valid_alternatives": {
    "forward": "WITH RECURSIVE reach(tenant,source,target) AS (SELECT tenant,source,target FROM edges WHERE status='active' UNION SELECT r.tenant,r.source,e.target FROM reach r JOIN edges e ON e.tenant=r.tenant AND e.source=r.target WHERE e.status='active') SELECT tenant,source,target FROM reach WHERE source<>target ORDER BY tenant,source,target",
    "backward": "WITH RECURSIVE reach(tenant,source,target) AS (SELECT tenant,source,target FROM edges WHERE status='active' UNION SELECT r.tenant,e.source,r.target FROM reach r JOIN edges e ON e.tenant=r.tenant AND e.target=r.source WHERE e.status='active') SELECT tenant,source,target FROM reach WHERE source<>target ORDER BY tenant,source,target"
  },
  "mutants": {
    "direct_only": "SELECT DISTINCT tenant,source,target FROM edges WHERE status='active' AND source<>target ORDER BY tenant,source,target",
    "two_hops_only": "WITH paths AS(SELECT tenant,source,target FROM edges WHERE status='active' UNION SELECT a.tenant,a.source,b.target FROM edges a JOIN edges b ON a.tenant=b.tenant AND a.target=b.source WHERE a.status='active' AND b.status='active')SELECT tenant,source,target FROM paths WHERE source<>target ORDER BY tenant,source,target",
    "undirected": "WITH RECURSIVE links(tenant,source,target) AS (SELECT tenant,source,target FROM edges WHERE status='active' UNION SELECT tenant,target,source FROM edges WHERE status='active'),reach(tenant,source,target) AS (SELECT * FROM links UNION SELECT r.tenant,r.source,e.target FROM reach r JOIN links e ON e.tenant=r.tenant AND e.source=r.target) SELECT tenant,source,target FROM reach WHERE source<>target ORDER BY tenant,source,target",
    "cross_tenant": "WITH RECURSIVE reach(tenant,source,target) AS (SELECT tenant,source,target FROM edges WHERE status='active' UNION SELECT r.tenant,r.source,e.target FROM reach r JOIN edges e ON e.source=r.target WHERE e.status='active') SELECT tenant,source,target FROM reach WHERE source<>target ORDER BY tenant,source,target",
    "inactive_edges": "WITH RECURSIVE reach(tenant,source,target) AS (SELECT tenant,source,target FROM edges UNION SELECT r.tenant,r.source,e.target FROM reach r JOIN edges e ON e.tenant=r.tenant AND e.source=r.target) SELECT tenant,source,target FROM reach WHERE source<>target ORDER BY tenant,source,target",
    "inactive_recursive_hop": "WITH RECURSIVE reach(tenant,source,target) AS (SELECT tenant,source,target FROM edges WHERE status='active' UNION SELECT r.tenant,r.source,e.target FROM reach r JOIN edges e ON e.tenant=r.tenant AND e.source=r.target) SELECT tenant,source,target FROM reach WHERE source<>target ORDER BY tenant,source,target",
    "reflexive_included": "WITH RECURSIVE reach(tenant,source,target) AS (SELECT tenant,source,target FROM edges WHERE status='active' UNION SELECT r.tenant,r.source,e.target FROM reach r JOIN edges e ON e.tenant=r.tenant AND e.source=r.target WHERE e.status='active') SELECT tenant,source,target FROM reach ORDER BY tenant,source,target",
    "ascending_pairs_only": "WITH RECURSIVE reach(tenant,source,target) AS (SELECT tenant,source,target FROM edges WHERE status='active' UNION SELECT r.tenant,r.source,e.target FROM reach r JOIN edges e ON e.tenant=r.tenant AND e.source=r.target WHERE e.status='active') SELECT tenant,source,target FROM reach WHERE source<target ORDER BY tenant,source,target",
    "wrong_order": "WITH RECURSIVE reach(tenant,source,target) AS (SELECT tenant,source,target FROM edges WHERE status='active' UNION SELECT r.tenant,r.source,e.target FROM reach r JOIN edges e ON e.tenant=r.tenant AND e.source=r.target WHERE e.status='active') SELECT tenant,source,target FROM reach WHERE source<>target ORDER BY tenant,source,target DESC"
