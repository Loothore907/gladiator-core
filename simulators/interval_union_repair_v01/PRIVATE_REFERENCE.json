  "reference_query": "WITH eligible AS (\n SELECT * FROM maintenance_windows WHERE status='active' AND start_tick<end_tick\n), prior AS (\n SELECT *, MAX(end_tick) OVER (PARTITION BY tenant,asset ORDER BY start_tick,end_tick,interval_id ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS previous_end FROM eligible\n), marked AS (\n SELECT *,CASE WHEN previous_end IS NULL OR start_tick>previous_end THEN 1 ELSE 0 END AS new_segment FROM prior\n), grouped AS (\n SELECT *,SUM(new_segment) OVER (PARTITION BY tenant,asset ORDER BY start_tick,end_tick,interval_id ROWS UNBOUNDED PRECEDING) AS segment FROM marked\n), spans AS (\n SELECT tenant,asset,segment,MIN(start_tick) AS lo,MAX(end_tick) AS hi FROM grouped GROUP BY tenant,asset,segment\n)\nSELECT tenant,asset,SUM(hi-lo) AS covered_ticks,COUNT(*) AS segments FROM spans GROUP BY tenant,asset ORDER BY tenant,asset",
  "status": "operator_only_not_contestant_input"
